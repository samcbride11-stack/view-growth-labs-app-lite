# Personal access token, scope: data.records:write, restricted to this one base
AIRTABLE_TOKEN=
# Starts with "app"
AIRTABLE_BASE_ID=
# Table ID (starts with "tbl") or "Signups"
AIRTABLE_TABLE=

# SendGrid API key with Mail Send permission. FROM_EMAIL must be a verified sender
# (or on a domain authenticated in SendGrid).
SENDGRID_API_KEY=
FROM_EMAIL=support@viewgrowthlabs.com

# Receives signup alerts, is the reply-to on visitor confirmation emails,
# and is shown to visitors if a submission fails
OWNER_EMAIL=

# Table ID (starts with "tbl") of the "Intake Info" table, used by the /intake form
AIRTABLE_TABLE_INTAKE=
